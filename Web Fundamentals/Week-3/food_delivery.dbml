
Project Food_Delivery_Database {
  database_type: 'PostgreSQL'
  Note: 'Food delivery platform with customers, restaurants, menus, orders, delivery assignments, payments and refunds.'
}

// ==========================================
// ENUMS
// ==========================================

Enum order_status {
  placed
  confirmed
  preparing
  ready_for_pickup
  out_for_delivery
  delivered
  cancelled
}

Enum payment_status {
  pending
  succeeded
  failed
  cancelled
}

Enum payment_method {
  upi
  card
  net_banking
  wallet
  cash_on_delivery
}

Enum assignment_status {
  offered
  accepted
  rejected
  picked_up
  delivered
  cancelled
}

Enum refund_status {
  pending
  succeeded
  failed
}

// ==========================================
// 1. CUSTOMERS
// One customer can have multiple addresses
// and multiple orders.
// ==========================================

Table customers {
  customer_id bigint [pk, increment]

  full_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  phone varchar(15) [unique]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ==========================================
// 2. CUSTOMER ADDRESSES
// One customer can save multiple addresses.
// ==========================================

Table addresses {
  address_id bigint [pk, increment]

  customer_id bigint [not null]

  address_type varchar(30) [not null, default: 'home']

  recipient_name varchar(100) [not null]
  recipient_phone varchar(15) [not null]

  address_line text [not null]
  landmark varchar(150)
  city varchar(100) [not null]
  state varchar(100) [not null]
  pincode varchar(10) [not null]

  is_default boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    customer_id
  }

  Note: 'Saved addresses belonging to customers. Enforce at most one default address per customer using a PostgreSQL partial unique index.'
}

// ==========================================
// 3. RESTAURANTS
// ==========================================

Table restaurants {
  restaurant_id bigint [pk, increment]

  name varchar(150) [not null]
  description text

  email varchar(255) [unique]
  phone varchar(15) [unique]

  address_line text [not null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  pincode varchar(10) [not null]

  is_active boolean [not null, default: true]
  is_accepting_orders boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ==========================================
// 4. MENUS
// One restaurant can have multiple menus.
// ==========================================

Table menus {
  menu_id bigint [pk, increment]

  restaurant_id bigint [not null]

  menu_name varchar(100) [not null]
  description text

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, menu_name) [unique]
  }
}

// ==========================================
// 5. MENU ITEMS
// One menu contains multiple food items.
// ==========================================

Table menu_items {
  menu_item_id bigint [pk, increment]

  menu_id bigint [not null]

  item_name varchar(150) [not null]
  description text

  price decimal(12,2) [not null, check: `price >= 0`]

  is_vegetarian boolean [not null, default: false]
  is_available boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (menu_id, item_name) [unique]
  }
}

// ==========================================
// 6. DELIVERY PARTNERS
// ==========================================

Table delivery_partners {
  partner_id bigint [pk, increment]

  full_name varchar(100) [not null]
  phone varchar(15) [not null, unique]

  is_available boolean [not null, default: true]
  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
}

// ==========================================
// 7. ORDERS
// One customer places multiple orders.
// One restaurant receives multiple orders.
//
// Delivery address is stored as a snapshot
// so historical orders remain unchanged.
// ==========================================

Table orders {
  order_id bigint [pk, increment]

  customer_id bigint [not null]
  restaurant_id bigint [not null]

  // Optional reference to customer's saved address
  source_address_id bigint

  // Delivery address snapshot
  recipient_name varchar(100) [not null]
  recipient_phone varchar(15) [not null]

  address_line text [not null]
  landmark varchar(150)
  city varchar(100) [not null]
  state varchar(100) [not null]
  pincode varchar(10) [not null]

  // Order price breakdown
  subtotal decimal(12,2) [not null, check: `subtotal >= 0`]

  delivery_fee decimal(12,2) [
    not null,
    default: 0,
    check: `delivery_fee >= 0`
  ]

  tax_amount decimal(12,2) [
    not null,
    default: 0,
    check: `tax_amount >= 0`
  ]

  discount_amount decimal(12,2) [
    not null,
    default: 0,
    check: `discount_amount >= 0`
  ]

  total_amount decimal(12,2) [
    not null,
    check: `total_amount >= 0`
  ]

  currency char(3) [not null, default: 'INR']

  status order_status [not null, default: 'placed']

  special_instructions text
  cancellation_reason text

  placed_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz
  delivered_at timestamptz
  cancelled_at timestamptz

  indexes {
    (customer_id, placed_at)
    (restaurant_id, placed_at)
    status
  }

  checks {
    `total_amount = subtotal + delivery_fee + tax_amount - discount_amount` [name: 'chk_order_total']
    `discount_amount <= subtotal` [name: 'chk_order_discount']
  }

  Note: 'Delivery address fields are snapshots. source_address_id is optional and only identifies the saved address originally selected.'
}

// ==========================================
// 8. ORDER ITEMS
// Junction table between orders and menu items.
//
// One order can contain multiple items.
// One menu item can appear in multiple orders.
//
// Snapshots preserve purchased item names and
// prices even when the menu changes.
// ==========================================

Table order_items {
  order_item_id bigint [pk, increment]

  order_id bigint [not null]

  // Nullable to preserve historical order
  // items if the original menu item is deleted.
  menu_item_id bigint

  item_name_snapshot varchar(150) [not null]

  quantity integer [not null, check: `quantity > 0`]

  unit_price_at_purchase decimal(12,2) [
    not null,
    check: `unit_price_at_purchase >= 0`
  ]

  special_instructions text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    order_id
    menu_item_id
  }

  Note: 'Each row represents one order line. Multiple lines for the same menu item are allowed for different customizations.'
}

// ==========================================
// 9. DELIVERY ASSIGNMENTS
// One order can have multiple assignment records
// to maintain reassignment history.
// ==========================================

Table delivery_assignments {
  assignment_id bigint [pk, increment]

  order_id bigint [not null]
  partner_id bigint [not null]

  status assignment_status [not null, default: 'offered']

  assigned_at timestamptz [not null, default: `now()`]
  accepted_at timestamptz
  picked_up_at timestamptz
  completed_at timestamptz

  indexes {
    (order_id, assigned_at)
    (partner_id, assigned_at)
  }

  Note: 'Retains delivery partner assignment history when an order is reassigned.'
}

// ==========================================
// 10. PAYMENTS
// One order can have multiple payment attempts.
// Failed attempts are preserved.
// ==========================================

Table payments {
  payment_id bigint [pk, increment]

  order_id bigint [not null]

  amount decimal(12,2) [
    not null,
    check: `amount > 0`
  ]

  currency char(3) [not null, default: 'INR']

  payment_method payment_method [not null]
  status payment_status [not null, default: 'pending']

  payment_provider varchar(100)
  provider_transaction_id varchar(255) [unique]

  idempotency_key varchar(255) [unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    order_id
    status
  }

  Note: 'Each row represents a payment attempt. A failed attempt remains in payment history.'
}

// ==========================================
// 11. REFUNDS
// One payment can have multiple partial refunds.
// ==========================================

Table refunds {
  refund_id bigint [pk, increment]

  payment_id bigint [not null]

  amount decimal(12,2) [
    not null,
    check: `amount > 0`
  ]

  status refund_status [not null, default: 'pending']

  reason text

  provider_refund_id varchar(255) [unique]

  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    payment_id
    status
  }

  Note: 'Separate refund records preserve partial refund and refund transaction history.'
}

// ==========================================
// RELATIONSHIPS
// ==========================================

// Customer -> Addresses
// One customer has many saved addresses.
Ref: customers.customer_id < addresses.customer_id

// Restaurant -> Menus
// One restaurant has many menus.
Ref: restaurants.restaurant_id < menus.restaurant_id

// Menu -> Menu Items
// One menu has many food items.
Ref: menus.menu_id < menu_items.menu_id

// Customer -> Orders
// One customer places many orders.
Ref: customers.customer_id < orders.customer_id

// Restaurant -> Orders
// One restaurant receives many orders.
Ref: restaurants.restaurant_id < orders.restaurant_id

// Saved Address -> Orders
// An address may be used for many orders.
// An order may have no saved-address reference.
Ref: addresses.address_id < orders.source_address_id [delete: set null]

// Orders -> Order Items
// One order contains multiple order lines.
Ref: orders.order_id < order_items.order_id

// Menu Items -> Order Items
// One menu item can appear in many order lines.
// Deleting a menu item preserves its order snapshot.
Ref: menu_items.menu_item_id < order_items.menu_item_id [delete: set null]

// Orders -> Delivery Assignments
// One order can have multiple assignment attempts.
Ref: orders.order_id < delivery_assignments.order_id

// Delivery Partners -> Delivery Assignments
// One delivery partner can have many assignments.
Ref: delivery_partners.partner_id < delivery_assignments.partner_id

// Orders -> Payments
// One order can have multiple payment attempts.
Ref: orders.order_id < payments.order_id

// Payments -> Refunds
// One payment can have multiple refund records.
Ref: payments.payment_id < refunds.payment_id
