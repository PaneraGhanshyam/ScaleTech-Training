Project Food_Delivery_Database {
  database_type: 'PostgreSQL'
  Note: 'Food delivery platform with customers, saved addresses, restaurants, operating hours, menus, orders, delivery assignments, payments, refunds and reviews.'
}

// ==========================================
// ENUMS
// ==========================================

Enum order_status {
  placed
  confirmed
  preparing
  ready_for_pickup
  out_for_delivery
  delivered
  cancelled
}

Enum payment_status {
  pending
  succeeded
  failed
  cancelled
}

Enum payment_method {
  upi
  card
  net_banking
  wallet
  cash_on_delivery
}

Enum assignment_status {
  offered
  accepted
  rejected
  picked_up
  delivered
  cancelled
}

Enum refund_status {
  pending
  succeeded
  failed
}

Enum vehicle_type {
  bicycle
  motorcycle
  scooter
  car
  other
}

Enum day_of_week {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// ==========================================
// 1. CUSTOMERS
// is_active = the customer's account is enabled
// ==========================================

Table customers {
  customer_id bigint [pk, increment]

  full_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  phone varchar(15) [unique]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ==========================================
// 2. CUSTOMER ADDRESSES
// Saved/profile addresses; orders keep their own snapshot.
// ==========================================

Table addresses {
  address_id bigint [pk, increment]
  customer_id bigint [not null]

  address_type varchar(30) [not null, default: 'home']
  recipient_name varchar(100) [not null]
  recipient_phone varchar(15) [not null]

  address_line text [not null]
  landmark varchar(150)
  city varchar(100) [not null]
  state varchar(100) [not null]
  pincode varchar(10) [not null]

  is_default boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    customer_id
  }

  Note: 'Saved customer addresses. Enforce at most one default address per customer with a PostgreSQL partial unique index.'
}

// ==========================================
// 3. RESTAURANTS
// is_active = approved/enabled on the platform
// is_accepting_orders = temporary order-taking switch
// Working hours are stored in restaurant_operating_hours.
// ==========================================

Table restaurants {
  restaurant_id bigint [pk, increment]

  name varchar(150) [not null]
  description text

  email varchar(255) [unique]
  phone varchar(15) [unique]

  address_line text [not null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  pincode varchar(10) [not null]
  business_timezone varchar(64) [not null, default: 'Asia/Kolkata']

  is_active boolean [not null, default: true]
  is_accepting_orders boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'A restaurant can be active on the platform but temporarily stop accepting orders. The operating-hours table defines its normal weekly schedule.'
}

// ==========================================
// 4. RESTAURANT OPERATING HOURS
// Multiple time slots per day support lunch and dinner breaks.
// ==========================================

Table restaurant_operating_hours {
  operating_hours_id bigint [pk, increment]
  restaurant_id bigint [not null]

  day_of_week day_of_week [not null]
  slot_number smallint [not null, default: 1, check: `slot_number > 0`]
  opens_at time
  closes_at time
  is_closed boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, day_of_week, slot_number) [unique]
  }

  checks {
    `(is_closed = true AND opens_at IS NULL AND closes_at IS NULL) OR (is_closed = false AND opens_at IS NOT NULL AND closes_at IS NOT NULL)` [name: 'chk_operating_hours_slot']
  }

  Note: 'Use one row for each opening slot. A restaurant with lunch and dinner hours can have two rows for the same day. When is_closed is true, opens_at and closes_at should be null; otherwise both are required. Store times in the restaurant business timezone.'
}

// ==========================================
// 5. MENUS
// is_published = menu is visible to customers
// ==========================================

Table menus {
  menu_id bigint [pk, increment]
  restaurant_id bigint [not null]

  menu_name varchar(100) [not null]
  description text
  is_published boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, menu_name) [unique]
  }
}

// ==========================================
// 6. MENU ITEMS
// is_available_for_order = temporarily orderable/in stock
// ==========================================

Table menu_items {
  menu_item_id bigint [pk, increment]
  menu_id bigint [not null]

  item_name varchar(150) [not null]
  description text
  price decimal(12,2) [not null, check: `price >= 0`]

  is_vegetarian boolean [not null, default: false]
  is_available_for_order boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (menu_id, item_name) [unique]
  }
}

// ==========================================
// 7. DELIVERY PARTNERS
// is_active = partner account is enabled/approved
// is_available_for_delivery = online and can receive a job
// ==========================================

Table delivery_partners {
  partner_id bigint [pk, increment]

  full_name varchar(100) [not null]
  phone varchar(15) [not null, unique]
  email varchar(255) [unique]

  vehicle_type vehicle_type [not null]
  vehicle_model varchar(100)
  vehicle_registration_number varchar(30) [unique]

  is_verified boolean [not null, default: false]
  is_available_for_delivery boolean [not null, default: false]
  is_active boolean [not null, default: true]

  last_known_latitude decimal(10,7)
  last_known_longitude decimal(10,7)
  last_location_updated_at timestamptz

  total_deliveries integer [not null, default: 0, check: `total_deliveries >= 0`]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `last_known_latitude IS NULL OR last_known_latitude between -90 and 90` [name: 'chk_partner_latitude']
    `last_known_longitude IS NULL OR last_known_longitude between -180 and 180` [name: 'chk_partner_longitude']
  }

  Note: 'Availability is a live working-state flag, not account activation. total_deliveries is an optional cached counter; delivery_assignments remains the source of truth. Location fields should be updated only when location sharing is enabled.'
}

// ==========================================
// 8. ORDERS
// Delivery address details are stored as one JSONB snapshot.
// selected_address_id identifies the saved address originally chosen.
// ==========================================

Table orders {
  order_id bigint [pk, increment]

  customer_id bigint [not null]
  restaurant_id bigint [not null]
  selected_address_id bigint

  delivery_address_snapshot jsonb [not null]

  subtotal decimal(12,2) [not null, check: `subtotal >= 0`]
  delivery_fee decimal(12,2) [not null, default: 0, check: `delivery_fee >= 0`]
  tax_amount decimal(12,2) [not null, default: 0, check: `tax_amount >= 0`]
  discount_amount decimal(12,2) [not null, default: 0, check: `discount_amount >= 0`]
  total_amount decimal(12,2) [not null, check: `total_amount >= 0`]
  currency char(3) [not null, default: 'INR']

  status order_status [not null, default: 'placed']
  special_instructions text
  cancellation_reason text

  placed_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz
  delivered_at timestamptz
  cancelled_at timestamptz
  delivery_address_changed_at timestamptz

  indexes {
    (customer_id, placed_at)
    (restaurant_id, placed_at)
    status
    selected_address_id
  }

  checks {
    `total_amount = subtotal + delivery_fee + tax_amount - discount_amount` [name: 'chk_order_total']
    `discount_amount <= subtotal` [name: 'chk_order_discount']
  }

  Note: 'delivery_address_snapshot JSONB should contain recipient_name, recipient_phone, address_line, landmark, city, state and pincode. It is the authoritative delivery destination for this order. selected_address_id points to the saved address selected at checkout and may be null. Permit snapshot changes only before out_for_delivery; record each change in order_address_history. Validate required JSON keys and value types in the application or with database constraints.'
}

// ==========================================
// 9. ORDER ADDRESS HISTORY
// Keeps an audit trail when destination changes before dispatch.
// ==========================================

Table order_address_history {
  address_history_id bigint [pk, increment]
  order_id bigint [not null]

  previous_address_snapshot jsonb [not null]
  new_address_snapshot jsonb [not null]
  change_reason text
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, changed_at)
  }

  Note: 'Insert the previous and new JSONB snapshots in the same database transaction as the orders row update. Reject address changes after the order becomes out_for_delivery, delivered or cancelled.'
}

// ==========================================
// 10. ORDER ITEMS
// Junction between orders and menu items.
// Snapshots preserve purchased item names and prices.
// ==========================================

Table order_items {
  order_item_id bigint [pk, increment]
  order_id bigint [not null]
  menu_item_id bigint

  item_name_snapshot varchar(150) [not null]
  quantity integer [not null, check: `quantity > 0`]
  unit_price_at_purchase decimal(12,2) [not null, check: `unit_price_at_purchase >= 0`]
  special_instructions text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    order_id
    menu_item_id
  }

  Note: 'Each row represents one order line. Multiple rows for the same menu item are allowed for different customizations. menu_item_id can be null if the original menu item is deleted.'
}

// ==========================================
// 11. DELIVERY ASSIGNMENTS
// Multiple rows preserve reassignment history.
// ==========================================

Table delivery_assignments {
  assignment_id bigint [pk, increment]
  order_id bigint [not null]
  partner_id bigint [not null]

  status assignment_status [not null, default: 'offered']

  assigned_at timestamptz [not null, default: `now()`]
  accepted_at timestamptz
  picked_up_at timestamptz
  completed_at timestamptz

  indexes {
    (order_id, assigned_at)
    (partner_id, assigned_at)
  }

  Note: 'Retains assignment history when an order is reassigned. Enforce at most one current active assignment per order with a PostgreSQL partial unique index over statuses considered active.'
}

// ==========================================
// 12. PAYMENTS
// One order can have multiple payment attempts.
// ==========================================

Table payments {
  payment_id bigint [pk, increment]
  order_id bigint [not null]

  amount decimal(12,2) [not null, check: `amount > 0`]
  currency char(3) [not null, default: 'INR']
  payment_method payment_method [not null]
  status payment_status [not null, default: 'pending']

  payment_provider varchar(100)
  provider_transaction_id varchar(255) [unique]
  idempotency_key varchar(255) [unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    order_id
    status
  }

  Note: 'Each row represents one payment attempt. Failed attempts remain in payment history.'
}

// ==========================================
// 13. REFUNDS
// One payment can have multiple partial refunds.
// ==========================================

Table refunds {
  refund_id bigint [pk, increment]
  payment_id bigint [not null]

  amount decimal(12,2) [not null, check: `amount > 0`]
  status refund_status [not null, default: 'pending']
  reason text
  provider_refund_id varchar(255) [unique]

  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    payment_id
    status
  }

  Note: 'Separate refund records preserve partial-refund and refund-transaction history.'
}

// ==========================================
// 14. RESTAURANT REVIEWS
// One restaurant review per delivered order.
// ==========================================

Table restaurant_reviews {
  restaurant_review_id bigint [pk, increment]
  order_id bigint [not null, unique]
  customer_id bigint [not null]
  restaurant_id bigint [not null]

  rating smallint [not null, check: `rating between 1 and 5`]
  comment text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, created_at)
    (customer_id, created_at)
  }

  Note: 'Allow a review only when the order is delivered and the customer, restaurant and order references match.'
}

// ==========================================
// 15. FOOD ITEM REVIEWS
// One food review per purchased order line.
// ==========================================

Table food_item_reviews {
  food_review_id bigint [pk, increment]
  order_item_id bigint [not null, unique]
  customer_id bigint [not null]

  rating smallint [not null, check: `rating between 1 and 5`]
  comment text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, created_at)
  }

  Note: 'The reviewed menu item is identified through order_items.menu_item_id. A review is allowed only for an order line belonging to a delivered order placed by this customer.'
}

// ==========================================
// 16. DELIVERY PARTNER REVIEWS
// Review is tied to the actual assignment, not just the order.
// ==========================================

Table delivery_partner_reviews {
  delivery_review_id bigint [pk, increment]
  assignment_id bigint [not null, unique]
  customer_id bigint [not null]

  rating smallint [not null, check: `rating between 1 and 5`]
  comment text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, created_at)
  }

  Note: 'The delivery partner and order are identified through delivery_assignments. Allow a review only for the delivered assignment belonging to this customer.'
}

// ==========================================
// RELATIONSHIPS
// ==========================================

// Customer -> Saved Addresses
Ref: customers.customer_id < addresses.customer_id

// Restaurant -> Operating Hours
Ref: restaurants.restaurant_id < restaurant_operating_hours.restaurant_id

// Restaurant -> Menus
Ref: restaurants.restaurant_id < menus.restaurant_id

// Menu -> Menu Items
Ref: menus.menu_id < menu_items.menu_id

// Customer -> Orders
Ref: customers.customer_id < orders.customer_id

// Restaurant -> Orders
Ref: restaurants.restaurant_id < orders.restaurant_id

// Saved Address -> Orders (optional original checkout selection)
Ref: addresses.address_id < orders.selected_address_id [delete: set null]

// Orders -> Address Change History
Ref: orders.order_id < order_address_history.order_id

// Orders -> Order Items
Ref: orders.order_id < order_items.order_id

// Menu Items -> Order Items (nullable to preserve history)
Ref: menu_items.menu_item_id < order_items.menu_item_id [delete: set null]

// Orders -> Delivery Assignments
Ref: orders.order_id < delivery_assignments.order_id

// Delivery Partners -> Delivery Assignments
Ref: delivery_partners.partner_id < delivery_assignments.partner_id

// Orders -> Payments
Ref: orders.order_id < payments.order_id

// Payments -> Refunds
Ref: payments.payment_id < refunds.payment_id

// Orders / Customers / Restaurants -> Restaurant Reviews
Ref: orders.order_id - restaurant_reviews.order_id
Ref: customers.customer_id < restaurant_reviews.customer_id
Ref: restaurants.restaurant_id < restaurant_reviews.restaurant_id

// Order Items / Customers -> Food Item Reviews
Ref: order_items.order_item_id - food_item_reviews.order_item_id
Ref: customers.customer_id < food_item_reviews.customer_id

// Delivery Assignments / Customers -> Delivery Partner Reviews
Ref: delivery_assignments.assignment_id - delivery_partner_reviews.assignment_id
Ref: customers.customer_id < delivery_partner_reviews.customer_id
